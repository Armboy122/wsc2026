# ============================================================
# PEA One Agent — การตั้งค่า FastAPI สำหรับระบบสาธิต
# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าที่จำเป็น
#
# คำเตือน:
# - ห้าม commit .env
# - ห้ามนำ API key ไปใส่ใน web/*.js หรือ web/*.html
# - OMS และ VOC ใช้ simulation=true แต่ OMS เรียก REST endpoint ที่ตั้งค่าไว้
# ============================================================


# ------------------------------------------------------------
# แอปพลิเคชัน
# ------------------------------------------------------------

# สภาพแวดล้อม: development หรือ production
APP_ENV=development

# ระดับ log: debug, info, warning หรือ error
LOG_LEVEL=info


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Origin ที่อนุญาต คั่นด้วยเครื่องหมายจุลภาค
# หน้าเว็บที่ FastAPI ให้บริการบน port 8000 เป็น same-origin อยู่แล้ว
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173


# ------------------------------------------------------------
# External OMS REST
# ------------------------------------------------------------
OMS_BASE_URL=http://127.0.0.1:8080/api/v1/oms
OMS_TIMEOUT_SECONDS=5
OMS_API_KEY=
# (ถ้าไม่กรอก ระบบจะไม่ส่ง X-API-Key header)

# External VOC REST gateway (simulation)
VOC_BASE_URL=http://127.0.0.1:8080/api/v1/voc
VOC_TIMEOUT_SECONDS=5
VOC_API_KEY=
# (ถ้าไม่กรอก ระบบจะไม่ส่ง X-API-Key header)

# รุ่นประกาศ PDPA ที่บันทึกเมื่อผู้ใช้กดยินยอมในโฟลว์เปิดเรื่อง VOC
VOC_CONSENT_NOTICE_VERSION=VOC-PDPA-DEMO-1.0


# ------------------------------------------------------------
# LINE Messaging API (เว้นว่างทั้งสองค่า = ปิดช่องทาง LINE)
# ------------------------------------------------------------
# Channel secret ใช้ตรวจลายเซ็น X-Line-Signature ของ webhook
# LINE_CHANNEL_SECRET=
# Channel access token ใช้ยิง reply/push/loading indicator
# LINE_CHANNEL_ACCESS_TOKEN=


# ------------------------------------------------------------
# LLM settings (ไม่มี credential)
# ------------------------------------------------------------

# ตั้ง provider/model/thinking/effort ของแต่ละ role ใน llm-settings.yaml
# ไฟล์นั้น track ได้เพราะไม่มี API key และแก้เพื่อสลับ Gemini/Local ได้ทันที
# หากเก็บไฟล์ config ที่ตำแหน่งอื่น ให้ระบุ path นี้
# LLM_SETTINGS_PATH=llm-settings.yaml
#
# Environment overrides (ใช้เฉพาะชั่วคราว):
# MAIN_LLM_PROVIDER=local
# MAIN_LLM_MODEL=qwen3.8-27b
# MAIN_LLM_THINKING=false
# MAIN_LLM_EFFORT=low  # low | medium | high


# ------------------------------------------------------------
# Knowledge (deterministic, no model/API key)
# ------------------------------------------------------------

# ตำแหน่งเอกสารความรู้ Markdown ที่ได้รับอนุมัติ; Gemini Live เลือกเอกสารจาก catalog เอง
KNOWLEDGE_SOURCE_ROOT=knowledge/source


# ------------------------------------------------------------
# Credentials (เก็บเฉพาะ environment ของระบบ ห้าม commit)
# ------------------------------------------------------------

# API key สำหรับ provider "gemini" ใน llm-settings.yaml:
# - Main Agent เมื่อเลือก provider=gemini
# - Gemini Live Voice Mode
GEMINI_API_KEY=

# API key สำหรับ provider "local" (OpenAI-compatible).
# เว้นว่างได้ถ้า endpoint ไม่ต้อง authentication.
# LOCAL_LLM_API_KEY=

# ------------------------------------------------------------
# Gemini Live Voice Mode
# ------------------------------------------------------------

# โมเดล Gemini Live สำหรับเสียงเรียลไทม์
GEMINI_LIVE_MODEL=gemini-3.8-live

# เสียงพูดของ Gemini Live
GEMINI_LIVE_VOICE=Puck

