# PEA One Agent — FastAPI platform configuration (demo only)
# Copy to .env and fill in before local development.

# Application
APP_ENV=development
LOG_LEVEL=info

# CORS (local demo; comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# LLM adapter: demo is the only bundled adapter. A live judge adapter is not
# bundled; it must be integrated through the LLMAdapter/JudgeLLMClient seam.
LLM_ADAPTER_NAME=demo

# Knowledge backend: Document Routing + Full-file Gemini Long Context
KNOWLEDGE_BACKEND_NAME=full_document

# Gemini runtime configuration (values must not be committed)
GEMINI_API_KEY=
KNOWLEDGE_SOURCE_ROOT=knowledge/source
# Optional: override the model used for document routing and long-context answers
GEMINI_LONG_CONTEXT_MODEL=gemini-3.6-flash
