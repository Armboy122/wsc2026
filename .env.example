# PEA One Agent — FastAPI platform configuration (demo only)
# Copy to .env and fill in before local development.

# Application
APP_ENV=development
LOG_LEVEL=info

# CORS (local demo; comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# LLM adapter (judge-provided; these are placeholders for health/readiness only)
LLM_ADAPTER_NAME=scripted

# Knowledge backend (Gemini File Search Hosted RAG; health/readiness placeholder)
KNOWLEDGE_BACKEND_NAME=gemini_file_search
