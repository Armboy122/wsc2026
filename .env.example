# ============================================================
# PEA One Agent — การตั้งค่า FastAPI สำหรับระบบสาธิต
# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าที่จำเป็น
#
# คำเตือน:
# - ห้าม commit .env
# - ห้ามนำ API key ไปใส่ใน web/*.js หรือ web/*.html
# - OMS และ VOC ใช้ simulation=true แต่ OMS เรียก REST endpoint ที่ตั้งค่าไว้
# ============================================================


# ------------------------------------------------------------
# แอปพลิเคชัน
# ------------------------------------------------------------

# สภาพแวดล้อม: development หรือ production
APP_ENV=development

# ระดับ log: debug, info, warning หรือ error
LOG_LEVEL=info


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Origin ที่อนุญาต คั่นด้วยเครื่องหมายจุลภาค
# หน้าเว็บที่ FastAPI ให้บริการบน port 8000 เป็น same-origin อยู่แล้ว
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173


# ------------------------------------------------------------
# External OMS REST
# ------------------------------------------------------------
OMS_BASE_URL=http://127.0.0.1:8080/api/v1/oms
OMS_TIMEOUT_SECONDS=5
OMS_API_KEY=
# (ถ้าไม่กรอก ระบบจะไม่ส่ง X-API-Key header)

# External VOC REST gateway (simulation)
VOC_BASE_URL=http://127.0.0.1:8080/api/v1/voc
VOC_TIMEOUT_SECONDS=5
VOC_API_KEY=
# (ถ้าไม่กรอก ระบบจะไม่ส่ง X-API-Key header)

# รุ่นประกาศ PDPA ที่บันทึกเมื่อผู้ใช้กดยินยอมในโฟลว์เปิดเรื่อง VOC
VOC_CONSENT_NOTICE_VERSION=VOC-PDPA-DEMO-1.0


# ------------------------------------------------------------
# LINE Messaging API (เว้นว่างทั้งสองค่า = ปิดช่องทาง LINE)
# ------------------------------------------------------------
# Channel secret ใช้ตรวจลายเซ็น X-Line-Signature ของ webhook
# LINE_CHANNEL_SECRET=
# Channel access token ใช้ยิง reply/push/loading indicator
# LINE_CHANNEL_ACCESS_TOKEN=


# ------------------------------------------------------------
# Main Agent LLM
# ------------------------------------------------------------

# Provider ที่รองรับ:
# - demo
# - gemini
# - maxplus_openai
MAIN_LLM_PROVIDER=gemini

# โมเดลของ Main Agent
MAIN_LLM_MODEL=gemini-3.5-flash-lite

# ใช้เฉพาะเมื่อต้องการ key แยกจาก provider หลัก
# ถ้าเว้นว่าง:
# - gemini จะใช้ GEMINI_API_KEY
# - maxplus_openai จะใช้ MAXPLUS_API_KEY
# MAIN_LLM_API_KEY=

# ใช้เฉพาะ provider ที่มี endpoint แบบ OpenAI-compatible
# ถ้าใช้ maxplus_openai และเว้นว่าง ระบบจะใช้ MAXPLUS_BASE_URL
# MAIN_LLM_BASE_URL=


# ------------------------------------------------------------
# Judge LLM
# ------------------------------------------------------------

# Judge แยกการตั้งค่าออกจาก Main Agent
# สำหรับการพัฒนาทั่วไปใช้ demo ได้
JUDGE_LLM_PROVIDER=demo

# กำหนดเมื่อเปลี่ยน Judge เป็น provider จริง
# JUDGE_LLM_MODEL=
# JUDGE_LLM_API_KEY=
# JUDGE_LLM_BASE_URL=


# ------------------------------------------------------------
# Knowledge Backend
# ------------------------------------------------------------

# ใช้ Document Routing และส่งข้อความฉบับเต็มของไฟล์ที่เลือก
KNOWLEDGE_BACKEND_NAME=full_document

# ตำแหน่งเอกสารความรู้
KNOWLEDGE_SOURCE_ROOT=knowledge/source


# ------------------------------------------------------------
# Knowledge LLM
# ------------------------------------------------------------

# Provider ที่รองรับ:
# - gemini
# - maxplus_openai
KNOWLEDGE_LLM_PROVIDER=gemini

# โมเดลสำหรับ Document Routing และ Full-file Long Context
KNOWLEDGE_LLM_MODEL=gemini-3.5-flash-lite

# ใช้เฉพาะเมื่อต้องการ key แยกจาก GEMINI_API_KEY หรือ MAXPLUS_API_KEY
# KNOWLEDGE_LLM_API_KEY=

# ใช้เฉพาะ provider ที่มี endpoint แบบ OpenAI-compatible
# KNOWLEDGE_LLM_BASE_URL=

# ชื่อเดิมที่ระบบยังรองรับ แต่ไม่ควรเปิดพร้อม KNOWLEDGE_LLM_PROVIDER
# KNOWLEDGE_PROVIDER=gemini


# ------------------------------------------------------------
# Google Gemini
# ------------------------------------------------------------

# API key หลักสำหรับ:
# - Main Agent เมื่อใช้ provider=gemini
# - Knowledge เมื่อใช้ provider=gemini
# - Gemini Live Voice Mode
GEMINI_API_KEY=

# โมเดล Long Context เริ่มต้นสำหรับ Knowledge
# จะถูกใช้เมื่อไม่ได้กำหนด KNOWLEDGE_LLM_MODEL
GEMINI_LONG_CONTEXT_MODEL=gemini-3.5-flash-lite


# ------------------------------------------------------------
# Gemini Live Voice Mode
# ------------------------------------------------------------

# โมเดลเสียงเรียลไทม์
# โมเดลนี้เป็น Preview และอาจมีการเปลี่ยนแปลง
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# เสียงพูดของ Gemini Live
GEMINI_LIVE_VOICE=Puck


# ------------------------------------------------------------
# MaxPlus OpenAI-compatible
# ------------------------------------------------------------

# ใช้เมื่อ MAIN_LLM_PROVIDER หรือ KNOWLEDGE_LLM_PROVIDER
# มีค่าเป็น maxplus_openai
MAXPLUS_API_KEY=

# Endpoint ต้องตรงกับ pool ที่ API key ได้รับอนุญาต
MAXPLUS_BASE_URL=https://api.maxplus-ai.cc/v1

# โมเดลเริ่มต้นของ MaxPlus
MAXPLUS_MODEL=deepseek-v4-flash-0731