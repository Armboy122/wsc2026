# ============================================================
# PEA Knowledge Voice Agent — environment settings
# ============================================================
# Copy to .env and fill in the required values.
#
# Warning:
# - Never commit .env
# - Never put an API key in web/*.js or web/*.html
# ============================================================

# development or production (/docs, /redoc and /openapi.json are always disabled)
APP_ENV=development

# debug, info, warning or error
LOG_LEVEL=info

# Gemini Live (ADK) — the only conversational model
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck

# Approved Markdown Knowledge documents (deterministic, no model/API key)
KNOWLEDGE_SOURCE_ROOT=knowledge/source

# Derived knowledge index cache (gitignored; safe to delete and rebuild)
KNOWLEDGE_INDEX_DIR=.cache/knowledge-index

# Embedder for the local knowledge index: bge-m3 (self-hosted, default) or fake
KNOWLEDGE_EMBEDDER=bge-m3
