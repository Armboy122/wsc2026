# ============================================================
# PEA Knowledge Voice Agent — environment settings
# ============================================================
# Copy to .env and fill in the required values.
#
# Warning:
# - Never commit .env
# - Never put an API key in web/*.js or web/*.html
# ============================================================

# development or production (production disables /docs and /redoc)
APP_ENV=development

# debug, info, warning or error
LOG_LEVEL=info

# Gemini Live (ADK) — the only conversational model
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck

# Approved Markdown Knowledge documents (deterministic, no model/API key)
KNOWLEDGE_SOURCE_ROOT=knowledge/source
