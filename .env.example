# PEA One Agent — FastAPI platform configuration
# Copy to .env and fill in before local development.

# Application
APP_ENV=development
LOG_LEVEL=info

# CORS (local demo; comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Main Agent LLM: demo, gemini, or maxplus_openai.
# MAIN_LLM_MODEL/API_KEY/BASE_URL are optional overrides; when omitted, the
# selected provider reuses GEMINI_* or MAXPLUS_* values below.
MAIN_LLM_PROVIDER=maxplus_openai
# MAIN_LLM_MODEL=
# MAIN_LLM_API_KEY=
# MAIN_LLM_BASE_URL=

# Judge LLM uses the same provider seam but remains independent.
JUDGE_LLM_PROVIDER=demo
# JUDGE_LLM_MODEL=
# JUDGE_LLM_API_KEY=
# JUDGE_LLM_BASE_URL=

# Knowledge backend: Document Routing + selected full-file long context
KNOWLEDGE_BACKEND_NAME=full_document
KNOWLEDGE_SOURCE_ROOT=knowledge/source

# Knowledge LLM: gemini (default) or maxplus_openai; optional overrides keep
# its model/key/base URL independent from Main and Judge.
KNOWLEDGE_LLM_PROVIDER=gemini
# KNOWLEDGE_LLM_MODEL=
# KNOWLEDGE_LLM_API_KEY=
# KNOWLEDGE_LLM_BASE_URL=
# Legacy KNOWLEDGE_PROVIDER is still accepted.

# Direct Google Gemini configuration (values must not be committed)
GEMINI_API_KEY=
GEMINI_LONG_CONTEXT_MODEL=gemini-3.5-flash
# Gemini Live voice mode (server-side API key; never expose to browser)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Puck

# MaxPlus OpenAI-compatible configuration. The base URL must match the key's pool.
MAXPLUS_API_KEY=
MAXPLUS_BASE_URL=https://api.maxplus-ai.cc/v1
MAXPLUS_MODEL=deepseek-v4-flash-0731

