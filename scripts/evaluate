#!/usr/bin/env python3
"""Run deterministic black-box evaluation against a PEA HTTP server."""
from __future__ import annotations

import json
import sys
import time
from pathlib import Path
from urllib.error import URLError
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "evaluation" / "datasets"
BASE = (sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:8000").rstrip("/")


def request(path: str, payload: dict | None = None) -> tuple[int, dict]:
    body = None if payload is None else json.dumps(payload).encode()
    req = Request(BASE + path, data=body, headers={"content-type": "application/json"}, method="POST" if body else "GET")
    try:
        with urlopen(req, timeout=10) as response:
            return response.status, json.loads(response.read())
    except (URLError, TimeoutError) as exc:
        return 0, {"error": str(exc)}


def main() -> int:
    rows = []
    for path in sorted(DATA.glob("*.jsonl")):
        with path.open(encoding="utf-8") as stream:
            rows.extend((path.stem, json.loads(line)) for line in stream if line.strip())
    started = time.perf_counter()
    status, health = request("/health")
    elapsed_ms = (time.perf_counter() - started) * 1000
    report = {
        "baseUrl": BASE,
        "datasetCounts": {},
        "routingAccuracy": None,
        "knowledgeCorrectness": None,
        "citationPresence": None,
        "unsupportedClaimRate": None,
        "writeSafety": None,
        "completion": 0.0,
        "healthStatus": status,
        "health": health,
        "responseTimeMs": round(elapsed_ms, 2),
        "notes": ["Run with a live server; this command never mutates production state."],
    }
    for name, _row in rows:
        report["datasetCounts"][name] = report["datasetCounts"].get(name, 0) + 1
    if status != 200:
        report["notes"].append("Server unavailable; no claims were scored.")
        print(json.dumps(report, indent=2, sort_keys=True))
        return 2
    # The full scored loop is intentionally explicit and reviewable. A response
    # is only counted complete when it is a valid JSON chat envelope.
    completed = 0
    for dataset, row in rows:
        code, response = request("/api/v1/chat", {"message": row["query"], "requestId": None})
        if code == 200 and {"conversationId", "traceId", "message", "citations", "pendingAction", "toolResults"} <= set(response):
            completed += 1
    report["completion"] = round(completed / len(rows), 4) if rows else 0.0
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["completion"] == 1 else 1


if __name__ == "__main__":
    raise SystemExit(main())
