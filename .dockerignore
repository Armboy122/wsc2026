# Allowlist: everything is excluded unless it is explicitly needed by Dockerfile.
# This keeps credentials, local state, VCS data, tests, and development tools out
# of the build context without hiding runtime Python modules or knowledge files.
*

!pyproject.toml
!uv.lock
!llm-settings.yaml
!app/
!app/**
!web/
!web/**
!knowledge/
!knowledge/source/
!knowledge/source/**
!knowledge/aliases/
!knowledge/aliases/**
!data/
!data/mock/
!data/mock/**

# Nested development-only files inside re-included runtime trees.
**/.git/
**/.git/**
**/.svn/
**/.svn/**
**/.venv/
**/.venv/**
**/.pi/
**/.pi/**
**/.agent-teams/
**/.agent-teams/**
**/.claude/
**/.claude/**
**/.agents/
**/.agents/**
**/logs/
**/logs/**
**/*.log
**/*.log.*
**/*.pid
**/.run/
**/.run/**
**/.runtime/
**/.runtime/**
**/.state/
**/.state/**
**/tests/
**/tests/**
**/__pycache__/
**/__pycache__/**
**/*.py[cod]
**/.pytest_cache/
**/.pytest_cache/**
**/.mypy_cache/
**/.mypy_cache/**
**/.ruff_cache/
**/.ruff_cache/**
**/.cache/
**/.cache/**
**/cache/
**/cache/**

# Nested secrets, private-key material, databases, and runtime state.
**/.env
**/.env.*
**/secrets/
**/secrets/**
**/secret/
**/secret/**
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
